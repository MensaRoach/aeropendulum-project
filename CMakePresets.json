{
    "version": 3,
    "configurePresets": [
        {
            "name": "default",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/.build/${presetName}",
            "toolchainFile": "${sourceDir}/.cmake/gcc-arm-none-eabi.cmake",
            "cacheVariables": {
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
            }
        },
        {
            "name": "Debug",
            "hidden": true,
            "inherits": "default",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "Release",
            "hidden": true,
            "inherits": "default",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "board-NUCLEO-F401RE",
            "hidden": true,
            "cacheVariables": {
                "BOARD_NAME": "NUCLEO-F401RE"
            }
        },
        {
            "name": "NUCLEO-F401RE-Debug",
            "displayName": "NUCLEO-F401RE (Debug)",
            "inherits": [
                "Debug",
                "board-NUCLEO-F401RE"
            ]
        },
        {
            "name": "NUCLEO-F401RE-Release",
            "displayName": "NUCLEO-F401RE (Release)",
            "inherits": [
                "Release",
                "board-NUCLEO-F401RE"
            ]
        }
    ],
    "buildPresets": [
        {
            "name": "NUCLEO-F401RE-Debug",
            "configurePreset": "NUCLEO-F401RE-Debug"
        },
        {
            "name": "NUCLEO-F401RE-Release",
            "configurePreset": "NUCLEO-F401RE-Release"
        }
    ]
}
